{
  /*
    Static-assets-only deploy: this is a prerendered Vite SPA (see
    scripts/prerender.mjs), not a Workers-runtime app, so there's no `main`
    worker script here. Without this file, `wrangler deploy` falls back to
    auto-detecting and configuring its own Vite integration, which requires
    Vite >= 6 — this repo is on Vite 5, so that auto-config path fails.
    Declaring the deploy explicitly here skips that detection entirely.
  */
  "name": "kivistone",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
